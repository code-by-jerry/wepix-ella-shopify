{% schema %}
{
  "name": "Custom Category Grid",
  "tag": "section",
  "class": "section-custom-category-grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "FEATURED CATEGORIES"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (with text baked in)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Category Grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-category-grid {
    display: grid;
    /* 3 columns on mobile */
    grid-template-columns: repeat(3, 1fr);
    /* Thin padding between images */
    gap: 4px;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  /* 6 columns on desktop (above 989px) */
  @media screen and (min-width: 990px) {
    .custom-category-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 6px;
    }
  }

  .custom-category-grid__title {
    text-align: center;
    margin: 0 0 20px;
    color: #111111;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-size: 18px;
    font-family: var(--font-body-family);
  }

  .custom-category-grid__item {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    text-decoration: none;
    line-height: 0;
  }

  .custom-category-grid__image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    display: block;
  }

  .custom-category-grid__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease-out;
  }

  /* Hover Zoom Effect */
  @media (hover: hover) {
    .custom-category-grid__item:hover .custom-category-grid__image {
      transform: scale(1.08);
    }
  }
</style>

<div class="custom-category-grid-wrapper page-width section-{{ section.id }}-padding">
  {% if section.settings.title != blank %}
    <h2 class="custom-category-grid__title">
      {{ section.settings.title }}
    </h2>
  {% endif %}

  <div class="custom-category-grid">
    {% for block in section.blocks %}
      {% if block.settings.link != blank %}
        <a href="{{ block.settings.link }}" class="custom-category-grid__item" {{ block.shopify_attributes }}>
      {% else %}
        <div class="custom-category-grid__item" {{ block.shopify_attributes }}>
      {% endif %}

      <div class="custom-category-grid__image-wrapper">
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 800 | image_tag: class: 'custom-category-grid__image', loading: 'lazy' }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'custom-category-grid__image placeholder-svg' }}
        {% endif %}
      </div>

      {% if block.settings.link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
