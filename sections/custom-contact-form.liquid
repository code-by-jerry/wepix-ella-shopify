<div class="custom-contact-form" style="padding: 60px 20px; max-width: 900px; margin: 0 auto;">
  <div style="margin-bottom: 40px;">
    <h2 style="font-size: 3rem; font-weight: 400; margin-bottom: 15px; color: #1a1a1a;">
      {{ section.settings.heading | escape }}
    </h2>
    <p style="font-size: 1.4rem; color: #4a4a4a; margin: 0;">
      {{ section.settings.subtitle | escape }}
    </p>
  </div>

  {% form 'contact', id: 'ContactForm', class: 'contact-form' %}
    {% if form.posted_successfully? %}
      <p class="form-status form-status-list form__message" tabindex="-1" autofocus style="color: green; font-size: 1.4rem; margin-bottom: 20px;">
        Thanks for contacting us. We'll get back to you as soon as possible.
      </p>
    {% elsif form.errors %}
      <div class="form__message" style="color: red; font-size: 1.4rem; margin-bottom: 20px;">
        <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
          Please adjust the following:
        </h2>
        <ul class="form-status-list caption-large" role="list">
          {% for field in form.errors %}
            <li>
              {% if field == 'form' %}
                {{ form.errors.messages[field] }}
              {% else %}
                <a href="#ContactForm-{{ field }}" class="link">
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <div class="contact-form__fields" style="display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap;">
      <div class="field" style="flex: 1; min-width: 300px;">
        <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Name" style="width: 100%; padding: 15px; border: 1px solid #e5e5e5; font-size: 1.4rem; outline: none; transition: border-color 0.3s;" onfocus="this.style.borderColor='#1a1a1a'" onblur="this.style.borderColor='#e5e5e5'">
      </div>
      <div class="field field--with-error" style="flex: 1; min-width: 300px;">
        <input
          autocomplete="email"
          type="email"
          id="ContactForm-email"
          class="field__input"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="ContactForm-email-error"
          {% endif %}
          placeholder="Email"
          required
          style="width: 100%; padding: 15px; border: 1px solid #e5e5e5; font-size: 1.4rem; outline: none; transition: border-color 0.3s;" onfocus="this.style.borderColor='#1a1a1a'" onblur="this.style.borderColor='#e5e5e5'"
        >
      </div>
    </div>
    
    <div class="field" style="margin-bottom: 20px;">
      <input type="tel" id="ContactForm-phone" class="field__input" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="Phone number" style="width: 100%; padding: 15px; border: 1px solid #e5e5e5; font-size: 1.4rem; outline: none; transition: border-color 0.3s;" onfocus="this.style.borderColor='#1a1a1a'" onblur="this.style.borderColor='#e5e5e5'">
    </div>

    <div class="field" style="margin-bottom: 30px;">
      <textarea
        rows="6"
        id="ContactForm-body"
        class="text-area field__input"
        name="contact[{{ 'templates.contact.form.comment' | t }}]"
        placeholder="Comment"
        style="width: 100%; padding: 15px; border: 1px solid #e5e5e5; font-size: 1.4rem; outline: none; resize: vertical; font-family: inherit; transition: border-color 0.3s;" onfocus="this.style.borderColor='#1a1a1a'" onblur="this.style.borderColor='#e5e5e5'"
      >
        {{- form.body -}}
      </textarea>
    </div>
    
    <div class="contact-button" style="margin-bottom: 30px;">
      <button type="submit" class="button" style="background-color: #1a1a1a; color: #ffffff; border: none; padding: 15px 40px; font-size: 1.3rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
        {{ section.settings.button_label | escape }}
      </button>
    </div>

    <div class="captcha-disclaimer" style="color: #666; font-size: 1.3rem;">
      {{ section.settings.disclaimer }}
    </div>
  {% endform %}
</div>

{% schema %}
{
  "name": "Custom Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Write to Us"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Please fill in the details.Please allow us 24Hrs to get back to you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SEND MESSAGE"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "<p>This site is protected by hCaptcha and the hCaptcha Privacy Policy and Terms of Service apply.</p>"
    }
  ],
  "presets": [
    {
      "name": "Custom Contact Form"
    }
  ]
}
{% endschema %}
