{{ 'custom-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-testimonials.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-testimonials-section page-width section-{{ section.id }}-padding">
  
  <div class="custom-testimonials-header">
    {%- if section.settings.title != blank -%}
      <h2 class="title inline-richtext">{{ section.settings.title }}</h2>
    {%- endif -%}
    
    {%- if section.settings.rating_text != blank or section.settings.verified_text != blank -%}
      <div class="custom-testimonials-summary">
        <div class="custom-testimonials-summary-stars">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          {%- endfor -%}
        </div>
        <span>{{ section.settings.rating_text }}</span>
        {%- if section.settings.verified_text != blank -%}
          <div class="custom-testimonials-verified">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            <span>{{ section.settings.verified_text }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <custom-testimonials>
    <div class="custom-testimonials-wrapper">
      <button class="custom-testimonials-arrow custom-testimonials-prev" disabled>
        <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>

      <div class="custom-testimonials-carousel">
        {%- for block in section.blocks -%}
          <div class="custom-testimonial-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'custom-testimonial-image' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'custom-testimonial-image placeholder-svg' }}
            {%- endif -%}

            <div class="custom-testimonial-content">
              {%- if block.settings.text != blank -%}
                <p class="custom-testimonial-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              <div class="custom-testimonial-stars">
                {%- for i in (1..block.settings.rating) -%}
                  <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                {%- endfor -%}
              </div>

              {%- if block.settings.author != blank -%}
                <p class="custom-testimonial-author">{{ block.settings.author | escape }}</p>
              {%- endif -%}

              {%- if block.settings.store_name != blank -%}
                <p class="custom-testimonial-footer">{{ block.settings.store_name | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <button class="custom-testimonials-arrow custom-testimonials-next">
        <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </custom-testimonials>
</div>

{% schema %}
{
  "name": "Custom Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Loved by 4 Lakh+ Women",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "rating_text",
      "default": "4.89 (1,876)",
      "label": "Rating Summary Text"
    },
    {
      "type": "text",
      "id": "verified_text",
      "default": "Verified",
      "label": "Verified Badge Text"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#ffffff",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "Absolutely loved this piece. The quality, fit, and detailing feel so premium. Am so happy to buy this.",
          "label": "Testimonial Text"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "text",
          "id": "author",
          "default": "Customer Name",
          "label": "Author Name"
        },
        {
          "type": "text",
          "id": "store_name",
          "default": "HAY!",
          "label": "Store Name Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
