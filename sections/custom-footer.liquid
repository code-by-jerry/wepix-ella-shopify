<div class="custom-footer" style="background-color: #000000; color: #ffffff; padding: 60px 0 20px;">
  <div class="page-width" style="max-width: 1400px; margin: 0 auto; padding: 0 40px;">
    
    <!-- Top Grid Section -->
    <div class="custom-footer__grid" style="display: grid; grid-template-columns: 1fr 1fr 1fr 1.5fr; gap: 40px; margin-bottom: 60px;">
      
      <!-- Column 1 -->
      <div class="custom-footer__col">
        <h4 style="font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 25px; color: #ffffff; font-weight: 600;">{{ section.settings.col1_heading }}</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 15px;">
          {% for block in section.blocks %}
            {% if block.type == 'link_col1' %}
              <li><a href="{{ block.settings.link }}" style="color: #a3a3a3; text-decoration: none; font-size: 1.4rem; transition: color 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a3a3a3'">{{ block.settings.label }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- Column 2 -->
      <div class="custom-footer__col">
        <h4 style="font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 25px; color: #ffffff; font-weight: 600;">{{ section.settings.col2_heading }}</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 15px;">
          {% for block in section.blocks %}
            {% if block.type == 'link_col2' %}
              <li><a href="{{ block.settings.link }}" style="color: #a3a3a3; text-decoration: none; font-size: 1.4rem; transition: color 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a3a3a3'">{{ block.settings.label }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- Column 3 -->
      <div class="custom-footer__col">
        <h4 style="font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 25px; color: #ffffff; font-weight: 600;">{{ section.settings.col3_heading }}</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 15px;">
          {% for block in section.blocks %}
            {% if block.type == 'link_col3' %}
              <li><a href="{{ block.settings.link }}" style="color: #a3a3a3; text-decoration: none; font-size: 1.4rem; transition: color 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a3a3a3'">{{ block.settings.label }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- Column 4 (Newsletter) -->
      <div class="custom-footer__col" style="grid-column: span 1;">
        <h4 style="font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 25px; color: #ffffff; font-weight: 600;">{{ section.settings.newsletter_heading }}</h4>
        
        <form method="post" action="/contact#ContactFooter" id="ContactFooter" accept-charset="UTF-8" class="footer__newsletter newsletter-form">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          <div class="newsletter-form__field-wrapper" style="position: relative; margin-bottom: 20px;">
            <input type="email" name="contact[email]" class="field__input" value="" placeholder="Enter email here" required style="width: 100%; background: transparent; border: none; border-bottom: 1px solid #444; color: #fff; padding: 10px 0; font-size: 1.4rem; outline: none;">
            <button type="submit" class="newsletter-form__button" name="commit" id="Subscribe" aria-label="Subscribe" style="position: absolute; right: 0; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #fff; cursor: pointer; padding: 10px;">
              <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg" style="width: 14px; height: 10px;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"></path>
              </svg>
            </button>
          </div>
        </form>

        <p style="color: #a3a3a3; font-size: 1.3rem; line-height: 1.5; margin-bottom: 25px; max-width: 300px;">
          {{ section.settings.newsletter_text }}
        </p>

        <!-- Social Icons -->
        <div class="custom-footer__socials" style="display: flex; gap: 15px;">
          {% if section.settings.social_facebook != blank %}
            <a href="{{ section.settings.social_facebook }}" target="_blank" style="color: #fff; text-decoration: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M14 13.5H16.5L17.5 9.5H14V7.5C14 6.47 14 5.5 16 5.5H17.5V2.14C17.174 2.097 15.943 2 14.643 2C11.928 2 10 3.657 10 6.7V9.5H7V13.5H10V22H14V13.5Z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_instagram != blank %}
            <a href="{{ section.settings.social_instagram }}" target="_blank" style="color: #fff; text-decoration: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
          {% endif %}
        </div>
      </div>
      
    </div> <!-- End Top Grid Section -->

    <!-- App Downloads Section -->
    <div class="custom-footer__apps" style="display: flex; gap: 20px; margin-bottom: 40px;">
      {% if section.settings.app_android_link != blank %}
        <a href="{{ section.settings.app_android_link }}" target="_blank" style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; border: 1px solid #444; border-radius: 8px; color: #fff; text-decoration: none; font-size: 1.3rem; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#fff'" onmouseout="this.style.borderColor='#444'">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg>
          Download the Android App
        </a>
      {% endif %}
      {% if section.settings.app_ios_link != blank %}
        <a href="{{ section.settings.app_ios_link }}" target="_blank" style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; border: 1px solid #444; border-radius: 8px; color: #fff; text-decoration: none; font-size: 1.3rem; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#fff'" onmouseout="this.style.borderColor='#444'">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg>
          Download the IOS App
        </a>
      {% endif %}
    </div>

    <!-- Copyright Bar -->
    <div class="custom-footer__bottom" style="border-top: 1px solid #222; padding-top: 20px; display: flex; justify-content: space-between; align-items: center;">
      <p style="color: #777; font-size: 1.2rem; margin: 0;">
        &copy; {{ 'now' | date: '%Y' }}, HAY! . All rights reserved.
      </p>
    </div>

  </div>
</div>

<style>
  @media screen and (max-width: 990px) {
    .custom-footer__grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media screen and (max-width: 750px) {
    .custom-footer__grid {
      grid-template-columns: 1fr !important;
      gap: 30px !important;
    }
    .custom-footer__apps {
      flex-direction: column;
    }
    .custom-footer__apps a {
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column 1 Heading",
      "default": "SHIPPING INFO"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 Heading",
      "default": "THE COMPANY"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 3 Heading",
      "default": "MY ACCOUNT"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "EXCLUSIVE BENEFITS"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Text",
      "default": "Apply for our free membership to receive exclusive deals, news, and events."
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook Link"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "app_android_link",
      "label": "Android App Link"
    },
    {
      "type": "url",
      "id": "app_ios_link",
      "label": "iOS App Link"
    }
  ],
  "blocks": [
    {
      "type": "link_col1",
      "name": "Col 1 Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        }
      ]
    },
    {
      "type": "link_col2",
      "name": "Col 2 Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        }
      ]
    },
    {
      "type": "link_col3",
      "name": "Col 3 Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}
