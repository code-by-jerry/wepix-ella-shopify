<hover-button class="swiper-button swiper-button-prev {{ class_prev }}">
  <span class="fill-bg absolute" data-fill-bg></span>
  <span class="svg-wrapper">
    {%- if arrows_type == 'custom-chevron' -%}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
    {%- else -%}
      {%- render 'icon-arrow', arrows_type: arrows_type -%}
    {%- endif -%}
  </span>
</hover-button>
<hover-button class="swiper-button swiper-button-next {{ class_next }}">
  <span class="fill-bg absolute" data-fill-bg></span>
  <span class="svg-wrapper">
    {%- if arrows_type == 'custom-chevron' -%}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
    {%- else -%}
      {%- render 'icon-arrow', arrows_type: arrows_type -%}
    {%- endif -%}
  </span>
</hover-button>

{% stylesheet %}
  .swiper-button {
    overflow: hidden;
    &:before {
      content: '';
      position: absolute;
      inset: 1px;
      background-color: var(--arrow-background);
      z-index: -1;
      border-radius: var(--arrow-radius);
    }

    @media (hover: hover) {
      &:hover {
        --arrow-color: var(--arrow-color-hover);
        --arrow-background: var(--arrow-background-hover);
      }
    }
  }

  .swiper-button .fill-bg {
    background-color: var(--arrow-color);
    z-index: -2;
    inset: -1px;
    border-radius: var(--arrow-radius);
  }

  .swiper-button-prev .fill-bg {
    transform: translateX(100%);
  }

  .swiper-button-next .fill-bg {
    transform: translateX(-100%);
  }
{% endstylesheet %}